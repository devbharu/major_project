# ==============================================================================
# Warren - .gitignore
# ==============================================================================

# Environment & Secrets
.env
.env.*
.env.local
.env.*.local
!.env.example

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, Coverage & Linters
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.tox/
.nox/

# Node.js & Frontend (React / Vite)
node_modules/
dist/
dist-ssr/
.vite/
.vite-temp/
.eslintcache
.stylelintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database & Persistent Storage (SQLite, ChromaDB, LangGraph Checkpoints)
.data/
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
