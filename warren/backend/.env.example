# =====================================================================================
# Warren Backend Configuration
# Copy this file to .env:  cp .env.example .env
# Never commit your .env file containing real API keys or secrets to Git.
# =====================================================================================

# -------------------------------------------------------------------------------------
# 1. Core & Server Settings
# -------------------------------------------------------------------------------------
# Environment mode: development | production
WARREN_ENV=development

# Server port (default 3000)
PORT=3000

# Secret key for signing sessions and JWTs (minimum 32 characters in production)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-characters-long

# Optional separate key for encrypting stored GitHub tokens at rest (Fernet key)
# If empty, a key is derived from SECRET_KEY automatically.
TOKEN_ENCRYPTION_KEY=

# User session lifetime in hours
SESSION_HOURS=24

# Frontend URL: where your React/Vite dashboard is hosted (e.g. Vercel)
# Supports comma-separated URLs if you want to allow both local dev and production:
# FRONTEND_URL=https://your-app-name.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Backend URL: where this Flask API is accessible from the internet
# Used for constructing the GitHub OAuth callback URL: ${BACKEND_URL}/api/auth/github/callback
# (e.g. https://your-backend.onrender.com or http://localhost:3000)
BACKEND_URL=http://localhost:3000

# Public URL for receiving GitHub webhooks (ngrok, cloudflared tunnel, or production domain)
# If left empty, Warren automatically uses its background poller instead of webhooks.
PUBLIC_URL=

# Set to true when running behind a reverse proxy / load balancer (Render, Railway, Heroku, Nginx)
# Enables trusting X-Forwarded-Proto, X-Forwarded-For, and secure HTTPS cookies.
TRUST_PROXY=false

# Database persistence:
# ":memory:" = in-memory SQLite (resets on restart).
# For production or data persistence, use a file path (e.g. warren.db or /data/warren.db).
SQLITE_PATH=:memory:

# Chroma vector database directory for semantic code search & learnings
CHROMA_PATH=.data/chroma

# LangGraph checkpoint store (enables CI Doctor to pause for human approval and resume)
CHECKPOINT_PATH=.data/checkpoints.db

# Seed demo data and enable read-only "Try the demo" button without connecting GitHub
DEMO_SEED=false

# Poller interval in seconds to poll GitHub when no public webhook URL is configured (0 = disabled)
POLL_INTERVAL_SECONDS=60


# -------------------------------------------------------------------------------------
# 2. GitHub Integration (OAuth & Webhooks)
# -------------------------------------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
# - Homepage URL: your FRONTEND_URL (e.g. https://your-app-name.vercel.app)
# - Authorization callback URL: ${BACKEND_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Webhook Secret: used to verify HMAC-SHA256 signatures of GitHub webhook payloads.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# Optional dedicated GitHub bot account Personal Access Token (PAT with repo + workflow scope).
# If provided, Warren posts comments and commits as this bot account instead of the signed-in user.
GITHUB_BOT_TOKEN=

# Chat trigger handle collaborators type in PR comments to invoke Warren
BOT_MENTION=@warren


# -------------------------------------------------------------------------------------
# 3. LLM / AI Configuration (OmniRoute or OpenAI-Compatible Gateway)
# -------------------------------------------------------------------------------------
# Base URL for the OpenAI-compatible API endpoint
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# Model identifier (e.g. gpt-4o, claude-3-5-sonnet, auto)
LLM_MODEL=auto

# Embeddings provider: default (Chroma's built-in MiniLM) | omniroute (/v1/embeddings)
EMBEDDINGS_PROVIDER=default
EMBEDDING_MODEL=


# -------------------------------------------------------------------------------------
# 4. E2B Cloud Sandbox (Test & Auto-fix Verification)
# -------------------------------------------------------------------------------------
# Get your API key at https://e2b.dev
# Warren uses E2B microVMs to reproduce defects and verify CI fixes before proposing them.
# (If left empty, Warren still reviews code, but all CI fixes pause for manual human approval).
E2B_API_KEY=

# Maximum duration (in seconds) to run a sandbox verification session
SANDBOX_TIMEOUT_SECONDS=900


# -------------------------------------------------------------------------------------
# 5. Observability (Optional)
# -------------------------------------------------------------------------------------
# Trace LangGraph execution steps, tool calls, and prompts in LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=warren

