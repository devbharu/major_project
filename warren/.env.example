# =====================================================================================
# Warren configuration. Copy to .env. Never commit .env.
# =====================================================================================

# ---------- Core ----------
# development | production. Production refuses unsafe settings (in-memory DB, demo data, http, missing secrets).
WARREN_ENV=development
# Required in production. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty in development a random key is used for that run (sessions reset on restart).
SECRET_KEY=
# Optional separate key for encrypting stored GitHub tokens (otherwise derived from SECRET_KEY).
TOKEN_ENCRYPTION_KEY=
SESSION_HOURS=24
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Public URL GitHub can reach for webhooks (ngrok/cloudflared/your domain). Empty = use the poller instead.
PUBLIC_URL=
# Set true when running behind a reverse proxy / load balancer (trusts one X-Forwarded-* hop).
TRUST_PROXY=false
# ":memory:" resets on restart. Use a file path (for example /data/warren.db) to keep data. Required in production.
SQLITE_PATH=:memory:
CHROMA_PATH=.data/chroma
# LangGraph checkpoint store: lets a CI fix pause for approval and resume after a restart.
CHECKPOINT_PATH=.data/checkpoints.db
# Seeds sample data and enables the read-only demo login. Never in production.
DEMO_SEED=false
# Without a webhook, poll enabled repositories every N seconds (0 = off).
POLL_INTERVAL_SECONDS=60

# ---------- GitHub ----------
# OAuth App (github.com/settings/developers). Callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required for webhooks (unsigned deliveries are rejected). Generate:  python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=
# Optional: token of a dedicated bot account so Warren posts as the bot instead of as you.
GITHUB_BOT_TOKEN=
# What collaborators type in PR comments to talk to the bot.
BOT_MENTION=@warren

# ---------- LLM (OmniRoute, OpenAI-compatible) ----------
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
LLM_MODEL=auto
# default = Chroma's built-in MiniLM (downloads once) | omniroute = /v1/embeddings | hash = offline fallback
EMBEDDINGS_PROVIDER=default
EMBEDDING_MODEL=

# ---------- E2B sandbox ----------
E2B_API_KEY=
SANDBOX_TIMEOUT_SECONDS=900

# ---------- Observability (optional): trace every graph run, tool call and LLM call in LangSmith ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=warren
